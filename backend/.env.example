# Copy to .env (or set real environment variables). Every value shown is the default unless noted.
DATA_DIR=./data                 # uploads, results, accounts DB live here
SECRET_KEY=                     # set a long random value in production; if empty one is generated and saved in DATA_DIR/.secret
MAX_FILE_MB=100
MAX_REQUEST_MB=300
MAX_FILES_PER_REQUEST=200
FILE_TTL_MINUTES=60             # files are deleted automatically after this
DOWNLOAD_LINK_TTL_SECONDS=3600
MAX_PAGES=2000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MUTATING_PER_MIN=60
RATE_LIMIT_READ_PER_MIN=600
MAX_WORKERS=4
LIBREOFFICE_CONCURRENCY=1
LIBREOFFICE_TIMEOUT=120
SUBPROCESS_TIMEOUT=120
AUTH_TOKEN_TTL_HOURS=168
TRUST_PROXY=false               # true only behind a reverse proxy that sets X-Forwarded-For
EXPOSE_RESET_TOKEN=false        # dev only: returns the password-reset token in the API response (no mail server is wired up)
FRONTEND_DIST=                  # path to frontend/dist to serve the SPA from the same process
UNICODE_FONT_PATH=              # optional TTF for non-Latin text in stamps (e.g. DejaVuSans.ttf)
